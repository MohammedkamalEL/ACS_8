          <label className="relative block sm:w-64">
            <span className="sr-only">ابحث عن نوع الطوارئ</span>
            <Icon name="search" className="pointer-events-none absolute start-3.5 top-1/2 size-4 -translate-y-1/2 text-stone-500" />
            <input
