<file path="src/pages/CheckInPage.jsx">
import { Link } from "react-router-dom";
import { useEffect, useRef } from "react";
import { useCheckIn } from "../hooks/useCheckIn";
import { useActivityLog } from "../hooks/useActivityLog";
import { usePersonalContacts } from "../hooks/usePersonalData";
import Icon from "../components/Icon";
import { formatCountdown, smsLink, toTel } from "../utils";
import { CHECKIN_EXTEND_MINUTES, CHECKIN_PRESETS } from "../data/options";

// رسالة جاهزة تُرسل لجهة اتصال عند انتهاء المؤقت
const ALERT_MESSAGE = "لم أؤكد سلامتي في تطبيق ساعدني بعد انتهاء المؤقت. أرجو أن تتصل بي أو تطمئن عليّ.";

// "أنا بخير؟": تحدد مدة، وإن لم تؤكد سلامتك قبل انتهائها تظهر لك جهات الاتصال فوراً
export default function CheckInPage() {
  const { deadline, remainingMs, expired, start, confirm, extend } = useCheckIn();
  const { contacts } = usePersonalContacts();
  const { record } = useActivityLog();
  const headingRef = useRef(null);

  useEffect(() => {
    headingRef.current?.focus();
  }, []);

  const handleStart = (minutes) => {
    start(minutes);
    record("checkin", `مؤقت ${minutes} دقيقة`);
  };

  const active = deadline !== null && !expired;

  return (
    <section className="mx-auto max-w-3xl space-y-6 px-4 py-8">
      <h1 ref={headingRef} tabIndex={-1} className="text-3xl font-black text-stone-900 outline-none">
        أنا بخير؟
      </h1>

      {/* لا يوجد مؤقت: اختر المدة */}
      {!deadline && (
        <div className="space-y-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
          <p className="text-stone-700">
            عند خروجك لمكان غير مألوف أو سفر أو عمل ليلي، اختر مدة. إن لم تؤكد سلامتك قبل انتهائها، يهتز جهازك وتظهر لك جهات الاتصال فوراً.
          </p>
          <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {CHECKIN_PRESETS.map((m) => (
              <button
                key={m}
                type="button"
                onClick={() => handleStart(m)}
                className="flex h-20 cursor-pointer flex-col items-center justify-center rounded-2xl border border-stone-300 bg-white font-bold text-stone-900 transition hover:border-sos hover:bg-rose-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-100"
              >
                <span className="text-2xl">{m}</span>
                <span className="text-xs font-semibold text-stone-600">دقيقة</span>
              </button>
            ))}
          </div>
          <p className="text-xs text-stone-500">
            هذا تذكير على جهازك فقط ويحتاج بقاء التطبيق مفتوحًا. لا يُرسل تنبيه تلقائي إلى أي شخص.
          </p>
        </div>
      )}

      {/* مؤقت نشط */}
      {active && (
        <div className="space-y-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-center shadow-sm">
          <p className="font-semibold text-emerald-800">المؤقت يعمل</p>
          <p dir="ltr" className="font-mono text-6xl font-black tabular-nums text-stone-900">
            {formatCountdown(remainingMs)}
          </p>
          <button
            type="button"
            onClick={confirm}
            className="inline-flex h-14 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-emerald-600 text-lg font-bold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-200"
          >
            <Icon name="check" className="size-5" />
            أنا بخير، أوقف المؤقت
          </button>
          <button
            type="button"
            onClick={() => extend(CHECKIN_EXTEND_MINUTES)}
            className="inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-emerald-300 bg-white font-semibold text-emerald-800 hover:bg-emerald-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-200"
          >
            <Icon name="plus" className="size-4" />
            تمديد {CHECKIN_EXTEND_MINUTES} دقيقة
          </button>
        </div>
      )}

      {/* انتهى الوقت دون تأكيد */}
      {expired && (
        <div role="alert" className="space-y-5 rounded-2xl border-2 border-rose-500 bg-rose-50 p-6 shadow-lg">
          <div className="flex items-start gap-3">
            <Icon name="alert" className="mt-1 size-7 shrink-0 text-rose-700" />
            <div>
              <p className="text-xl font-black text-rose-800">انتهى الوقت دون تأكيد سلامتك</p>
              <p className="mt-1 text-sm text-rose-900">اتصل بمن تثق بهم الآن، أو اطلب المساعدة الرسمية.</p>
            </div>
          </div>

          {contacts.length > 0 && (
            <ul className="grid gap-3">
              {contacts.map((c) => (
                <li key={c.id}>
                  <div className="flex gap-2">
                    <a
                      href={toTel(c.phone)}
                      onClick={() => record("call", c.name)}
                      aria-label={`اتصل بـ${c.name}`}
                      className="flex min-h-14 flex-1 items-center justify-between gap-3 rounded-xl bg-white px-4 py-3 font-bold text-stone-900 shadow-sm ring-1 ring-rose-200 transition hover:bg-rose-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-300"
                    >
                      <span>اتصل بـ{c.name}</span>
                      <Icon name="phone" className="size-5 text-emerald-700" />
                    </a>
                    <a
                      href={smsLink(c.phone, ALERT_MESSAGE)}
                      onClick={() => record("sms", c.name)}
                      aria-label={`أرسل رسالة اطمئنان إلى ${c.name}`}
                      className="inline-flex min-h-14 w-14 items-center justify-center rounded-xl bg-white text-stone-800 shadow-sm ring-1 ring-rose-200 hover:bg-rose-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-300"
                    >
                      <Icon name="message" className="size-5" />
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          )}

          <div className="grid gap-3 sm:grid-cols-2">
            <Link
              to="/sos"
              className="inline-flex h-12 items-center justify-center rounded-xl bg-sos font-bold text-white hover:bg-sos-dark focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-200"
            >
              الطوارئ الآن
            </Link>
            <button
              type="button"
              onClick={confirm}
              className="inline-flex h-12 cursor-pointer items-center justify-center rounded-xl border border-stone-300 bg-white font-semibold text-stone-800 hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-200"
            >
              أنا بخير الآن
            </button>
            <button
              type="button"
              onClick={() => extend(CHECKIN_EXTEND_MINUTES)}
              className="inline-flex h-12 cursor-pointer items-center justify-center rounded-xl border border-stone-300 bg-white font-semibold text-stone-800 hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-200 sm:col-span-2"
            >
              أحتاج {CHECKIN_EXTEND_MINUTES} دقيقة إضافية
            </button>
          </div>
        </div>
      )}
    </section>
  );
}
</file>

<file path="src/pages/ContactsPage.jsx">
import { useState } from "react";
import { usePersonalContacts, useMedicalProfile } from "../hooks/usePersonalData";
import Icon from "../components/Icon";
import { MAX_PERSONAL_CONTACTS, BLOOD_TYPES, LOG_LABELS } from "../data/options";
import { isValidPhone, toTel, formatDateTime } from "../utils";
import { useActivityLog } from "../hooks/useActivityLog";

const INPUT =
  "h-12 w-full rounded-xl border border-stone-300 bg-white px-4 text-stone-900 placeholder:text-stone-500 focus:border-sos focus:outline-none focus:ring-4 focus:ring-rose-100";
const TEXTAREA =
  "min-h-20 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 placeholder:text-stone-500 focus:border-sos focus:outline-none focus:ring-4 focus:ring-rose-100";

const EMPTY_DRAFT = { name: "", relation: "", phone: "" };

// إدارة جهات الطوارئ الشخصية والبطاقة الطبية، والكل محفوظ على الجهاز فقط
export default function ContactsPage() {
  const { contacts, addContact, removeContact } = usePersonalContacts();
  const { profile, saveProfile } = useMedicalProfile();
  const { log, clear: clearLog } = useActivityLog();

  const [draft, setDraft] = useState(EMPTY_DRAFT);
  const [error, setError] = useState("");

  const [form, setForm] = useState(profile);
  const [saved, setSaved] = useState(false);

  const handleAdd = (e) => {
    e.preventDefault();
    if (contacts.length >= MAX_PERSONAL_CONTACTS) {
      setError(`الحد الأقصى ${MAX_PERSONAL_CONTACTS} جهات`);
      return;
    }
    if (!draft.name.trim()) {
      setError("اكتب اسم الشخص");
      return;
    }
    if (!isValidPhone(draft.phone)) {
      setError("اكتب رقم هاتف صحيح");
      return;
    }
    addContact({
      name: draft.name.trim(),
      relation: draft.relation.trim(),
      phone: draft.phone.trim(),
    });
    setDraft(EMPTY_DRAFT);
    setError("");
  };

  const handleSaveProfile = (e) => {
    e.preventDefault();
    saveProfile(form);
    setSaved(true);
  };

  const updateForm = (key) => (e) => {
    setSaved(false);
    setForm((f) => ({ ...f, [key]: e.target.value }));
  };

  return (
    <section className="mx-auto max-w-3xl space-y-8 px-4 py-8">
      <header>
        <h1 className="text-3xl font-black text-stone-900">جهاتي</h1>
        <p className="mt-1 text-stone-600">
          بياناتك محفوظة على هذا الجهاز فقط، ولا تُرسل إلى أي جهة.
        </p>
      </header>

      {/* جهات الطوارئ الشخصية */}
      <div className="space-y-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <div>
          <h2 className="font-bold text-stone-900">أشخاص تثق بهم</h2>
          <p className="text-sm text-stone-600">
            تظهر أولاً في شاشة الطوارئ ({contacts.length} من {MAX_PERSONAL_CONTACTS})
          </p>
        </div>

        {contacts.length > 0 && (
          <ul className="divide-y divide-stone-100">
            {contacts.map((c) => (
              <li key={c.id} className="flex items-center justify-between gap-3 py-3">
                <div className="min-w-0">
                  <p className="truncate font-bold text-stone-900">
                    {c.name}
                    {c.relation && <span className="ms-2 text-sm font-normal text-stone-600">({c.relation})</span>}
                  </p>
                  <p dir="ltr" className="font-mono text-sm text-stone-700">{c.phone}</p>
                </div>
                <div className="flex shrink-0 gap-2">
                  <a
                    href={toTel(c.phone)}
                    aria-label={`اتصل بـ${c.name}`}
                    className="inline-flex size-11 items-center justify-center rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-200"
                  >
                    <Icon name="phone" className="size-5" />
                  </a>
                  <button
                    type="button"
                    onClick={() => removeContact(c.id)}
                    aria-label={`حذف ${c.name}`}
                    className="inline-flex size-11 cursor-pointer items-center justify-center rounded-xl border border-stone-300 text-stone-700 hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-200"
                  >
                    <Icon name="trash" className="size-5" />
                  </button>
                </div>
              </li>
            ))}
          </ul>
        )}

        {contacts.length < MAX_PERSONAL_CONTACTS && (
          <form onSubmit={handleAdd} noValidate className="grid gap-3 border-t border-stone-100 pt-4 sm:grid-cols-2">
            <label className="block">
              <span className="mb-1.5 block text-sm font-medium text-stone-700">الاسم</span>
              <input className={INPUT} value={draft.name} onChange={(e) => setDraft({ ...draft, name: e.target.value })} placeholder="مثال: أمي" />
            </label>
            <label className="block">
              <span className="mb-1.5 block text-sm font-medium text-stone-700">صلة القرابة (اختياري)</span>
              <input className={INPUT} value={draft.relation} onChange={(e) => setDraft({ ...draft, relation: e.target.value })} placeholder="مثال: الأم" />
            </label>
            <label className="block sm:col-span-2">
              <span className="mb-1.5 block text-sm font-medium text-stone-700">رقم الهاتف</span>
              <input
                className={INPUT}
                dir="ltr"
                inputMode="tel"
                value={draft.phone}
                onChange={(e) => setDraft({ ...draft, phone: e.target.value })}
                placeholder="+249 ..."
              />
            </label>
            {error && (
              <p role="alert" className="text-sm font-semibold text-rose-700 sm:col-span-2">
                {error}
              </p>
            )}
            <button
              type="submit"
              className="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded-xl bg-stone-900 font-bold text-white hover:bg-stone-800 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-300 sm:col-span-2"
            >
              <Icon name="plus" className="size-5" />
              إضافة الشخص
            </button>
          </form>
        )}
      </div>

      {/* سجل الإجراءات على هذا الجهاز */}
      <div className="space-y-3 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <div className="flex items-center justify-between">
          <h2 className="font-bold text-stone-900">سجل الطوارئ على هذا الجهاز</h2>
          {log.length > 0 && (
            <button
              type="button"
              onClick={clearLog}
              className="cursor-pointer text-sm font-semibold text-rose-700 hover:underline"
            >
              مسح السجل
            </button>
          )}
        </div>
        {log.length === 0 ? (
          <p className="text-sm text-stone-600">لا توجد إجراءات مسجّلة بعد.</p>
        ) : (
          <ul className="divide-y divide-stone-100">
            {log.slice(0, 10).map((entry) => (
              <li key={entry.id} className="flex items-center justify-between gap-3 py-2.5 text-sm">
                <span className="font-semibold text-stone-900">
                  {LOG_LABELS[entry.type] ?? entry.type}: {entry.label}
                </span>
                <time dateTime={new Date(entry.at).toISOString()} className="shrink-0 text-xs text-stone-600">
                  {formatDateTime(entry.at)}
                </time>
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* البطاقة الطبية */}
      <form onSubmit={handleSaveProfile} className="space-y-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <div>
          <h2 className="font-bold text-stone-900">بطاقتي الطبية</h2>
          <p className="text-sm text-stone-600">تُعرض للمسعفين في شاشة الطوارئ. اكتب ما تعرفه فقط، والباقي اختياري.</p>
        </div>

        <div className="grid gap-4 sm:grid-cols-2">
          <label className="block">
            <span className="mb-1.5 block text-sm font-medium text-stone-700">الاسم الكامل</span>
            <input className={INPUT} value={form.name} onChange={updateForm("name")} />
          </label>
          <label className="block">
            <span className="mb-1.5 block text-sm font-medium text-stone-700">فصيلة الدم</span>
            <select className={INPUT} value={form.bloodType} onChange={updateForm("bloodType")}>
              <option value="">غير معروفة</option>
              {BLOOD_TYPES.map((b) => (
                <option key={b} value={b}>{b}</option>
              ))}
            </select>
          </label>
          <label className="block sm:col-span-2">
            <span className="mb-1.5 block text-sm font-medium text-stone-700">الحساسية</span>
            <textarea className={TEXTAREA} value={form.allergies} onChange={updateForm("allergies")} placeholder="مثال: البنسلين، المكسرات" />
          </label>
          <label className="block sm:col-span-2">
            <span className="mb-1.5 block text-sm font-medium text-stone-700">حالات مزمنة</span>
            <textarea className={TEXTAREA} value={form.conditions} onChange={updateForm("conditions")} placeholder="مثال: السكري، الضغط" />
          </label>
          <label className="block sm:col-span-2">
            <span className="mb-1.5 block text-sm font-medium text-stone-700">أدوية مستمرة</span>
            <textarea className={TEXTAREA} value={form.medications} onChange={updateForm("medications")} placeholder="مثال: الإنسولين صباحًا" />
          </label>
        </div>

        <div className="flex items-center gap-3">
          <button
            type="submit"
            className="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded-xl bg-sos px-6 font-bold text-white hover:bg-sos-dark focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-200"
          >
            <Icon name="save" className="size-5" />
            حفظ البطاقة
          </button>
          {saved && (
            <span role="status" className="text-sm font-semibold text-emerald-700">
              تم الحفظ
            </span>
          )}
        </div>
      </form>
    </section>
  );
}
