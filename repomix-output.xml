<file path="src/hooks/useCheckIn.js">
import { useEffect, useState } from "react";
import { useLocalStorage } from "./useLocalStorage";

// مؤقت "أنا بخير": يحفظ موعد الانتهاء، فيبقى المؤقت بعد إعادة تحميل الصفحة.
// notify: عند true يهتز الجهاز ويتغيّر عنوان التبويب لحظة الانتهاء (يُفعَّل مرة واحدة في App).
export function useCheckIn({ notify = false } = {}) {
  const [deadline, setDeadline] = useLocalStorage("sos.checkin", null);
  const [now, setNow] = useState(() => Date.now());

  // تحديث الوقت كل ثانية فقط عندما يكون مؤقت نشطًا
  useEffect(() => {
    if (!deadline) return;
    const id = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(id);
  }, [deadline]);

  const start = (minutes) => {
    setNow(Date.now());
    setDeadline(Date.now() + minutes * 60_000);
  };
  const confirm = () => setDeadline(null);
  // تمديد المؤقت (من الآن إن كان قد انتهى، أو من موعده إن كان جارياً)
  const extend = (minutes) => {
    setNow(Date.now());
    setDeadline((d) => Math.max(d ?? 0, Date.now()) + minutes * 60_000);
  };

  const remainingMs = deadline ? deadline - now : null;
  const expired = deadline !== null && remainingMs <= 0;

  useEffect(() => {
    if (!notify || !expired) return;
    const previousTitle = document.title;
    navigator.vibrate?.([400, 200, 400, 200, 800]);
    document.title = "⚠ لم تؤكد سلامتك | ساعدني";
    return () => {
      document.title = previousTitle;
    };
  }, [notify, expired]);

  return { deadline, remainingMs, expired, start, confirm, extend };
}
</file>

<file path="src/hooks/useEmergencyTypes.js">
import { useEffect, useState } from "react";
import { getCachedEmergencyTypes, getEmergencyType, getEmergencyTypes } from "../api";

// كل أنواع الطوارئ: loading ثم ready أو error. تبدأ ready فوراً إن كانت البيانات جاهزة.
export function useEmergencyTypes() {
  const [state, setState] = useState(() => {
    const cached = getCachedEmergencyTypes();
    return cached ? { status: "ready", data: cached } : { status: "loading", data: [] };
  });

  useEffect(() => {
    let alive = true;
    getEmergencyTypes()
      .then((data) => alive && setState({ status: "ready", data }))
      .catch(() => alive && setState((s) => (s.status === "ready" ? s : { status: "error", data: [] })));
    return () => {
      alive = false;
    };
  }, []);

  return state;
}

// نوع طوارئ واحد: loading ثم ready أو notfound أو error
export function useEmergencyType(id) {
  const [state, setState] = useState(() => {
    const found = getCachedEmergencyTypes()?.find((t) => t.id === id);
    return found ? { status: "ready", data: found } : { status: "loading", data: null };
  });

  useEffect(() => {
    let alive = true;
    getEmergencyType(id)
      .then((data) => alive && setState({ status: data ? "ready" : "notfound", data }))
      .catch(() => alive && setState({ status: "error", data: null }));
    return () => {
      alive = false;
    };
  }, [id]);

  return state;
}
</file>

<file path="src/hooks/useGeolocation.js">
import { useCallback, useState } from "react";

// موقع اختياري بضغطة زر: لا يُطلب إلا عندما يضغط المستخدم، ولا يُحفظ ولا يُرسل لأي خادم.
// الحالات: idle ثم loading ثم ok أو denied أو unavailable أو timeout
export function useGeolocation() {
  const [state, setState] = useState({ status: "idle", coords: null });

  const request = useCallback(() => {
    if (!("geolocation" in navigator)) {
      setState({ status: "unavailable", coords: null });
      return;
    }
    setState({ status: "loading", coords: null });
    navigator.geolocation.getCurrentPosition(
      (pos) =>
        setState({
          status: "ok",
          coords: { lat: pos.coords.latitude, lng: pos.coords.longitude, accuracy: Math.round(pos.coords.accuracy) },
        }),
      (err) =>
        setState({
          status: err.code === 1 ? "denied" : err.code === 3 ? "timeout" : "unavailable",
          coords: null,
        }),
      { enableHighAccuracy: true, timeout: 12_000, maximumAge: 60_000 }
    );
  }, []);

  const clear = useCallback(() => setState({ status: "idle", coords: null }), []);

  return { ...state, request, clear };
}
</file>

<file path="src/hooks/useInstallPrompt.js">
import { useEffect, useState } from "react";

// يلتقط عرض التثبيت من المتصفح ليُعرض زر "ثبّت التطبيق" في الوقت المناسب
export function useInstallPrompt() {
  const [promptEvent, setPromptEvent] = useState(null);

  useEffect(() => {
    const onPrompt = (e) => {
      e.preventDefault();
      setPromptEvent(e);
    };
    const onInstalled = () => setPromptEvent(null);
    window.addEventListener("beforeinstallprompt", onPrompt);
    window.addEventListener("appinstalled", onInstalled);
    return () => {
      window.removeEventListener("beforeinstallprompt", onPrompt);
      window.removeEventListener("appinstalled", onInstalled);
    };
  }, []);

  const install = async () => {
    if (!promptEvent) return;
    promptEvent.prompt();
    await promptEvent.userChoice;
    setPromptEvent(null);
  };

  return { canInstall: Boolean(promptEvent), install };
}
</file>

<file path="src/hooks/useLocalStorage.js">
import { useCallback, useMemo, useState, useSyncExternalStore } from "react";

// تخزين محلي متزامن بين كل أجزاء التطبيق:
// أي تغيير يظهر فوراً في كل مكوّن يقرأ نفس المفتاح (وبين تبويبات المتصفح أيضاً).
// كان كل مكوّن يحتفظ بنسخة خاصة، فيضيع السجل لو سجّل مكوّنان في نفس الصفحة.

const listeners = new Set();
const memory = new Map(); // احتياطي إن كان التخزين ممتلئاً أو معطّلاً: تبقى البيانات طوال الجلسة

const notify = () => listeners.forEach((l) => l());
window.addEventListener("storage", notify);

const subscribe = (cb) => {
  listeners.add(cb);
  return () => listeners.delete(cb);
};

const readRaw = (key) => {
  if (memory.has(key)) return memory.get(key);
  try {
    return localStorage.getItem(key);
  } catch {
    return null;
  }
};

const writeRaw = (key, raw) => {
  try {
    localStorage.setItem(key, raw);
    memory.delete(key);
  } catch {
    memory.set(key, raw);
  }
  notify();
};

const parse = (raw, fallback) => {
  if (raw == null) return fallback;
  try {
    return JSON.parse(raw);
  } catch {
    return fallback;
  }
};

// حالة مرتبطة بـ localStorage: تُقرأ عند البداية وتُحفظ وتُبثّ عند كل تغيير
export function useLocalStorage(key, initialValue) {
  const [initial] = useState(initialValue);
  const raw = useSyncExternalStore(subscribe, () => readRaw(key));
  const value = useMemo(() => parse(raw, initial), [raw, initial]);

  const update = useCallback(
    (next) => {
      // نحسب القيمة الجديدة من آخر نسخة محفوظة، لا من نسخة قديمة في هذا المكوّن
      const prev = parse(readRaw(key), initial);
      const resolved = typeof next === "function" ? next(prev) : next;
      writeRaw(key, JSON.stringify(resolved));
    },
    [key, initial]
  );

  return [value, update];
}
</file>

<file path="src/hooks/useOnlineStatus.js">
import { useEffect, useState } from "react";

// يتابع حالة الاتصال بالإنترنت ويتحدّث تلقائياً
export function useOnlineStatus() {
  const [online, setOnline] = useState(() => navigator.onLine);

  useEffect(() => {
    const goOnline = () => setOnline(true);
    const goOffline = () => setOnline(false);
    window.addEventListener("online", goOnline);
    window.addEventListener("offline", goOffline);
    return () => {
      window.removeEventListener("online", goOnline);
      window.removeEventListener("offline", goOffline);
    };
  }, []);

  return online;
}
</file>

<file path="src/hooks/usePersonalData.js">
import { useLocalStorage } from "./useLocalStorage";

const EMPTY_PROFILE = {
  name: "",
  bloodType: "",
  allergies: "",
  conditions: "",
  medications: "",
};

// معرّف بسيط يعمل حتى في الاتصال غير الآمن (http)
const makeId = () => `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`;

// جهات اتصال شخصية يضيفها المستخدم ويحفظها على جهازه
export function usePersonalContacts() {
  const [contacts, setContacts] = useLocalStorage("sos.contacts", []);

  const addContact = (contact) =>
    setContacts((list) => [...list, { ...contact, id: makeId() }]);

  const removeContact = (id) => setContacts((list) => list.filter((c) => c.id !== id));

  return { contacts, addContact, removeContact };
}

// البطاقة الطبية المختصرة للمستخدم، تُعرض للمسعفين عند الحاجة
export function useMedicalProfile() {
  const [profile, setProfile] = useLocalStorage("sos.profile", EMPTY_PROFILE);

  const saveProfile = (next) => setProfile({ ...EMPTY_PROFILE, ...next });

  return { profile: { ...EMPTY_PROFILE, ...profile }, saveProfile };
}
